# Copy to .env (git-ignored) and adjust. Nothing here is a secret.

# Local OpenAI-compatible model for tactic suggestions. Suggestions are advisory and are
# never used to decide whether a proof is verified.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Lean verification is OFF by default, because Lean executes code while it elaborates
# submitted text. Turn it on only on a machine where that is acceptable.
AUTOPROOF_TRUSTED_LEAN=0
# LEAN_COMMAND=lean
# LEAN_TIMEOUT=30
# LEAN_MEMORY_MB=4096
# LEAN_PROJECT_DIR=/path/to/lake/project

# Proof database (default: backend/autoproof.db).
# DATABASE_PATH=backend/autoproof.db

# Browser origins allowed to call the API.
# AUTOPROOF_CORS_ORIGINS=http://localhost:3000
